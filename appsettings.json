{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5200"
      }
    }
  },

  "SynchrolightApi": {
    "BaseUrl": "http://localhost:5100",
    "AutoStart": {
      "Enabled": true,
      "ExePath": null,
      "ProjectPath": "..\\SynchrolightAPI\\SynchrolightAPI.Api",
      "StartupTimeoutSeconds": 90
    }
  },

  "Transmitter": {
    "Channel": 4,
    "Power": 0
  },

  "Demo": {
    "Field": 1,
    "MaxId": 200,
    "SequentialIntervalMs": 500,
    "BlinkOnMs": 500,
    "BlinkGapMs": 0,
    "GlobalBlinkOnMs": 500,
    "GlobalBlinkOffMs": 500,
    "RefreshIntervalMs": 0,
    "InterPacketDelayMs": 5,
    "GroupProgramNo": 8,
    "RainbowProgramNo": 6
  }
}
