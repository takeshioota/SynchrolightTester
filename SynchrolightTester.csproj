<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SynchrolightTester</RootNamespace>
    <AssemblyName>SynchrolightTester</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF版は別プロジェクト（SynchrolightTester.Wpf）。Web側のビルド対象から除外する。 -->
    <Compile Remove="SynchrolightTester.Wpf\**" />
    <Content Remove="SynchrolightTester.Wpf\**" />
    <EmbeddedResource Remove="SynchrolightTester.Wpf\**" />
    <None Remove="SynchrolightTester.Wpf\**" />
  </ItemGroup>

</Project>
