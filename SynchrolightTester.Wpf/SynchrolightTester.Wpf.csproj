<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>SynchrolightTester.Wpf</RootNamespace>
    <AssemblyName>SynchrolightTester.Wpf</AssemblyName>
    <!-- 画面右上・マニュアルに表示するバージョン。更新時はここを変更する。 -->
    <Version>1.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generic Host(DI/Options/Logging/Configuration) 一式。IHttpClientFactory は使わず HttpClient を直接DIするため Microsoft.Extensions.Http は不要。 -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
