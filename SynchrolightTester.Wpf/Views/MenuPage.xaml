<Page x:Class="SynchrolightTester.Wpf.Views.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="メニュー" Background="#F5F7FA">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
            <TextBlock Text="テスト項目を選択してください" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="ID書込み済シンクロライト端末の個別操作確認"
                       Foreground="#52606D" HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <Button x:Name="BtnRowId" Height="92" Margin="0,0,0,18" Click="OnRowId"
                    Background="#1E88E5" Foreground="White" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="行ID操作確認" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="連続点灯／連続点滅／奇数点灯／偶数点灯（対象端末数 1〜200）"
                               FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnBlockId" Height="92" Click="OnBlockId"
                    Background="#00897B" Foreground="White" BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="ブロックID操作確認" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="グループ1点灯／グループ2点灯（ブロックIDエリア）"
                               FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Text="※ 操作前に上部バーでCOM接続＋送信機初期化を行ってください。"
                       Foreground="#829AB1" FontSize="12" HorizontalAlignment="Center" Margin="0,24,0,0"/>
        </StackPanel>
    </Grid>
</Page>
