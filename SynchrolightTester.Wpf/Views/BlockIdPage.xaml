<Page x:Class="SynchrolightTester.Wpf.Views.BlockIdPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ブロックID操作確認" Background="#F5F7FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- ヘッダ（タイトルと戻るは従来どおり上段） -->
            <DockPanel Margin="0,0,0,16">
                <Button Content="◀ メニューへ戻る" DockPanel.Dock="Right" Padding="12,5" Click="OnBack"/>
                <TextBlock Text="ブロックID操作確認" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 点灯色選択以下はウィンドウ中央に寄せる -->
            <StackPanel HorizontalAlignment="Center" Width="760">

                <!-- 点灯色選択（グループ点灯で使用） -->
                <TextBlock Text="点灯色選択（グループ点灯で使用）"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Button x:Name="BtnBlue"  Content="青" Style="{StaticResource ColorButton}" Background="#1E88E5" Click="OnColor"/>
                    <Button x:Name="BtnGreen" Content="緑" Style="{StaticResource ColorButton}" Background="#43A047" Click="OnColor"/>
                    <Button x:Name="BtnRed"   Content="赤" Style="{StaticResource ColorButton}" Background="#E53935" Click="OnColor"/>
                </StackPanel>

                <!-- 既存機能（グループ点灯＝ブロックIDエリア8の値で制御） -->
                <TextBlock Text="既存機能（各機能は排他。選択時は一旦全消灯してから実行。ブロックIDエリア8の値で制御）"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="グループ1点灯"        Style="{StaticResource FuncButton}" Click="OnGroup1"/>
                    <Button Content="グループ2点灯"        Style="{StaticResource FuncButton}" Click="OnGroup2"/>
                    <Button Content="消灯"                 Style="{StaticResource OffButton}"  Click="OnOff"/>
                </WrapPanel>

                <!-- 追加機能（指定ID点灯＝ブロックIDエリア1の値で制御）／追加仕様 20261101訂 -->
                <TextBlock Text="追加機能（指定ID点灯＝ブロックIDエリア1の値で制御。整数で指定、未入力時は実行しません）"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="指定ID：" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBox x:Name="BlockIdBox" Width="80" VerticalContentAlignment="Center"
                             TextAlignment="Right" Padding="4,2"/>
                    <TextBlock Text="（整数で指定）" Foreground="#52606D" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="指定ID点灯"           Style="{StaticResource FuncButton}" Click="OnBlockId"/>
                </WrapPanel>

                <!-- ▼ レインボー送出間隔テスト（検証用）
                     7色ACを1発ずつ可変間隔で発行し、送信機(FA/FB)がどこまで詰めて送っても追従できるかを観察する。
                     間隔はサーバ(API)側で正確に効く（Stopwatchスピン待機）。
                     ※追加仕様20261101訂（次期版・v1.4.0ベース）ではレインボー検証機能は非表示（Collapsed）。 -->
                <Border Visibility="Collapsed" Background="White" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="レインボー 送出間隔テスト（検証用）" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="7色のACコマンドを1発ずつ下記の発行間隔で順次送出します。間隔を変えて送信機(FA/FB)の追従・点灯の見え方を確認します。"
                                   Foreground="#52606D" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <!-- 発行間隔スライダー（0〜10ms / 1ms刻み・実行中は変更不可） -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="ACパケット発行間隔：" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Slider x:Name="GapSlider" Width="260" Minimum="0" Maximum="10"
                                    TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                    Value="3" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ElementName=GapSlider, Path=Value, StringFormat={}{0:0} ms}"
                                       FontWeight="Bold" Width="48" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="（0=連続発行 〜 10ms, 1ms刻み／実行中は変更不可）"
                                       Foreground="#52606D" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="レインボー点灯(固定)"  Style="{StaticResource FuncButton}" Click="OnRainbow"/>
                            <Button Content="レインボー点灯(シフト)" Style="{StaticResource FuncButton}" Click="OnRainbowShift"/>
                        </WrapPanel>

                        <!-- レインボー凡例 -->
                        <TextBlock Text="レインボー固定7色（ブロックIDエリア7＝7進法割当。値1〜7をAC/ブロック制御で点灯）。固定=レベル1（各値に対応色で点灯・保持）／シフト=レベル2（約0.5秒間隔で発光色を順次シフト）"
                                   Foreground="#52606D" FontSize="12" Margin="0,8,0,6" TextWrapping="Wrap"/>
                        <StackPanel x:Name="RainbowLegend" Orientation="Horizontal"/>
                    </StackPanel>
                </Border>

                <!-- 状態・ログ -->
                <Border Background="White" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Text="待機中" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ListBox x:Name="LogList" Height="100" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
